# Read pages (read-only role in production). SQLite file path, file: URL, or postgres:// URL.
DATABASE_URL=file:./.dev/sim.sqlite
# Control writes (INSERT into commands and interventions only). Falls back to DATABASE_URL.
DATABASE_URL_CONTROL=
# Single researcher account.
DASHBOARD_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`.
DASHBOARD_SESSION_SECRET=
